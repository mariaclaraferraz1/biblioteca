<!doctype html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>


  <body>

    <!-- cabeçalho -->
   <header class="bg-dark text-white py-4 px-2"> 
    <h1 class="text-center">Bem vindo(a) à Biblioteca Virtual</h1> 
    <figure class="text-center">
      <blockquote class="blockquote">
        <p>Quem mal lê, mal ouve, mal fala, mal vê</p>
      </blockquote>
      <figcaption class="blockquote-footer text-white">
       <cite title="Source Title">Monteiro Lobato</cite>
      </figcaption>
    </figure> 
  </header>
  <!--  -->

  <!-- Livros cadastrados -->
   <section class="container mt-3"> 
      <div class="row">

        <!-- livro 1-->
        <div class="col-3">
          <div class="card shadow" style="width: 15rem;">
            <img class="card-img-top pt-4 px-4" src="https://m.media-amazon.com/images/I/91DZobBc1BL.jpg" alt="">
            <div class="card-body">
              <h5 class="card-title">
                Coraline
              </h5>
              <p class="text-secondary">Neil Gaiman</p>
              <button class="btn btn-dark w-100">Ler agora</button>
            </div>
          </div>
        </div> <!-- fim da col livro -->

        <!-- livro 2-->
        <div class="col-3">
          <div class="card shadow" style="width: 15rem;">
            <img class="card-img-top pt-4 px-4" src="https://m.media-amazon.com/images/I/91UjIwmok9L.jpg" alt="">
            <div class="card-body">
              <h5 class="card-title">
                O verão que mudou minha vida
              </h5>
              <p class="text-secondary">Jenny Han</p>
              <button class="btn btn-dark w-100">Ler agora</button>
            </div>
          </div>
        </div> <!-- fim da col livro -->

      </div> <!-- fim da row -->
   </section>
   <!--  -->

   <footer> Rodape </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>